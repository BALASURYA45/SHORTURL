PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS. Supports wildcards like "*.vercel.app".
# In non-production, localhost dev origins are also allowed automatically.
FRONTEND_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string
# Optional: used to generate hard-to-guess short codes (HMAC). If omitted, JWT_SECRET is used.
SLUG_SECRET=
MONGODB_URI=mongodb://localhost:27017/shorturo
# Optional: path to GeoLite2 City .mmdb file (for geo analytics)
GEOLITE2_CITY_MMDB_PATH=
# Optional: set true if behind a proxy/tunnel and you want Express to respect X-Forwarded-For
TRUST_PROXY=false

# Optional: URL threat detection ("heuristic", "safebrowsing", or "ai")
URL_SAFETY_MODE=heuristic
# Optional: required if URL_SAFETY_MODE=safebrowsing
SAFE_BROWSING_API_KEY=

# Optional: required if URL_SAFETY_MODE=ai
OPENAI_API_KEY=
# Optional: model used for URL_SAFETY_MODE=ai
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Sign-In web client ID
GOOGLE_CLIENT_ID=
